# Server-side only. No VITE_ prefix; never commit real credentials.
LLM_PROVIDER=openai-responses
# Select service endpoint including /v1 where required.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000
API_PORT=3001
TASK_DB_PATH=.local/tasks.sqlite
APP_ORIGIN=http://localhost:5173
# Local development needs no login by default. Public production fails closed without APP_PASSWORD.
# Set a unique 16–256 character login password in the hosting service's secret environment.
APP_PASSWORD=
AUTH_DB_PATH=.local/access.sqlite
UPLOAD_DIR=.local/uploads
# Production: NODE_ENV=production, APP_ORIGIN=https://your-hostname, API_HOST=0.0.0.0.
# Render supplies PORT and RENDER_EXTERNAL_URL automatically; do not use a frontend VITE_ secret.
